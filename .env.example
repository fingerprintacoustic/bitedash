# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Paynow's Integration ID/Key are NOT app secrets and are never read from
# this file — the app never talks to Paynow directly. They're configured as
# Cloud Functions secrets instead (see functions/README.md), so that a
# decompiled APK can never leak them and a compromised client can never
# forge a "paid" response.
