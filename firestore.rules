rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is an admin
    // Looks up the caller's own user document and checks their role field.
    // (Previously compared uid to the literal string 'admin', which could
    // never match a real Firebase Auth UID — this made isAdmin() always
    // false and silently fell through to the more permissive per-resource
    // rules below.)
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is a driver (by their own user document's role field).
    function isDriver() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver';
    }

    // A driver whose own drivers/{uid} profile has been approved by an
    // admin. Self-registered drivers start with isApproved == false —
    // this gates delivery discovery/claiming so a brand-new, unvetted
    // signup can't start picking up paid orders before an admin has had
    // a chance to review them, mirroring the restaurant approval gate.
    // Checks "!= false" rather than "== true": driver documents created
    // before this field existed have no isApproved value at all, and
    // those pre-existing drivers (already trusted, already delivering)
    // must not suddenly get locked out — only an explicit false (which
    // is all self-registration ever writes) blocks.
    function isApprovedDriver() {
      return isDriver() &&
        exists(/databases/$(database)/documents/drivers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.isApproved != false;
    }

    // A restaurant's owner (by UID) or an extra staff member the owner
    // added (by email, since we can't look up a UID from an email
    // client-side). Emails are stored lowercase and compared lowercase
    // so casing differences don't silently lock someone out.
    function isRestaurantOwnerOrStaff(restaurantId) {
      let r = get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
      return isAuthenticated() && (
        r.ownerUserId == request.auth.uid ||
        (request.auth.token.email != null && request.auth.token.email.lower() in r.staffEmails)
      );
    }
    
    // ==================== USERS ====================
    
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can create their own profile, but cannot self-assign the
      // admin role (admin must be granted by an existing admin via the
      // "Admin can manage all user profiles" rule below).
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.role != 'admin';
      
      // Users can update their own profile (except role)
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'address', 'ecoCashNumber', 'oneMoneyNumber', 'updatedAt']);
      
      // Admin can read and manage all user profiles. Previously this was
      // write-only — admin had no read/list grant on this collection at
      // all, so any admin screen listing users (getUsersFlow /
      // getUsersFlowByRole) would come back empty even for a real admin,
      // the same way the drivers collection silently empties out for
      // non-admin callers.
      allow read, write: if isAdmin();
    }
    
    // ==================== RESTAURANTS ====================
    
    match /restaurants/{restaurantId} {
      // Anyone can read active restaurants (public menu viewing)
      allow read: if resource.data.isActive == true;
      
      // Only authenticated users can list restaurants
      allow list: if isAuthenticated();
      
      // A restaurant-role account can create its own restaurant listing,
      // self-linked via ownerUserId, pending admin approval — mirroring
      // driver self-registration. Previously the only create rule below
      // was admin-only, so "Create My Restaurant" was rejected
      // server-side for every non-admin account even after reaching that
      // screen; this was masked because the role-selection tab bug meant
      // real restaurant signups almost never got that far to notice.
      // isApproved must be false on self-create — same reasoning as the
      // driver create rule above, so a client can't just self-approve.
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUserId == request.auth.uid &&
        request.resource.data.isApproved == false;

      // Restaurant owners can update anything on their own restaurant.
      // Staff (added by the owner via staffEmails) can update everything
      // except who owns the restaurant or who else has staff access —
      // only the owner manages that.
      allow update: if isAuthenticated() && (
        resource.data.ownerUserId == request.auth.uid ||
        (
          isRestaurantOwnerOrStaff(restaurantId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUserId', 'staffEmails'])
        )
      );
      
      // Admin can create/update/delete any restaurant
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== MENU ITEMS ====================
    
    match /menu_items/{menuItemId} {
      // Anyone can read menu items (public menu viewing)
      allow read: if resource.data.isAvailable == true;

      // The owner (or their staff) can read their own full menu regardless
      // of availability — without this, marking an item "Sold Out" made it
      // permanently invisible even to its own restaurant, with no way to
      // toggle it back on.
      allow read: if isRestaurantOwnerOrStaff(resource.data.restaurantId);

      // Restaurant owners and their staff can manage menu items
      allow create: if isAuthenticated() && 
        exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)) &&
        isRestaurantOwnerOrStaff(request.resource.data.restaurantId);
      
      allow update, delete: if isAuthenticated() && 
        resource.data.restaurantId != null &&
        exists(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)) &&
        isRestaurantOwnerOrStaff(resource.data.restaurantId);
      
      // Admin can manage all menu items
      allow write: if isAdmin();
    }
    
    // ==================== CARTS ====================
    
    match /carts/{cartId} {
      // Users can only read their own cart
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can only create/update their own cart
      allow create, update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Users can only delete their own cart (clear)
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ==================== ORDERS ====================
    
    match /orders/{orderId} {
      // Customers can read their own orders
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Restaurant owners can read orders for their restaurant
      allow read: if isAuthenticated() && 
        exists(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerUserId == request.auth.uid;
      
      // Drivers can read orders assigned to them
      allow read: if isAuthenticated() && resource.data.driverId == request.auth.uid;
      
      // Drivers can read unclaimed deliveries so they have something to
      // claim in the first place (getAvailableDeliveriesFlow queries
      // deliveryStatus == "UNASSIGNED" across all restaurants).
      allow read: if isApprovedDriver() && resource.data.deliveryStatus == 'UNASSIGNED';
      
      // Admin can read all orders
      allow read: if isAdmin();
      
      // Customers can create orders
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Restaurant owners can update order status
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'acceptedAt']);
      
      // A driver claiming an unassigned, ready delivery (assignDriverToOrder):
      // sets driverId to their own uid, driverName, and deliveryStatus.
      allow update: if isApprovedDriver() &&
        resource.data.deliveryStatus == 'UNASSIGNED' &&
        resource.data.driverId == null &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['driverId', 'driverName', 'deliveryStatus', 'updatedAt']);
      
      // Drivers can update order/delivery status on deliveries already
      // assigned to them (pickup, deliver). Includes deliveryStatus —
      // updateDeliveryStatus() writes deliveryStatus + updatedAt only,
      // which the previous version of this rule didn't permit.
      allow update: if isAuthenticated() && 
        resource.data.driverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deliveryStatus', 'updatedAt', 'completedAt']);
      
      // Admin can update any order
      allow update: if isAdmin();
      
      // No one can delete orders (audit trail)
      allow delete: if false;
    }
    
    // ==================== PAYMENTS ====================
    
    match /payments/{paymentId} {
      // Users can read their own payments
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Restaurant owners can read payments for their orders
      allow read: if isAuthenticated() && 
        exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.restaurantId != null &&
        exists(/databases/$(database)/documents/restaurants/$(get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.restaurantId)).data.ownerUserId == request.auth.uid;
      
      // Drivers can read payments for their deliveries
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.driverId == request.auth.uid;
      
      // Admin can read all payments
      allow read: if isAdmin();

      // Payments are created and updated only by the initiatePaynowPayment /
      // checkPaynowPaymentStatus / paynowResultWebhook Cloud Functions
      // (Admin SDK, bypasses these rules) after they've verified the
      // transaction with Paynow directly. A client can never self-report
      // "PAID" — that decision is never made by a device the customer
      // controls. Admin can still write directly for support/manual fixes.
      allow create, update: if isAdmin();
      
      // No deletion of payments (audit trail)
      allow delete: if false;
    }
    
    // ==================== DRIVERS ====================
    
    match /drivers/{driverId} {
      // Drivers can read their own profile. resource == null covers a
      // driver checking whether their own profile exists yet, before
      // it's been created.
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );

      // A driver-role account can create its own profile, self-linked by
      // using their Firebase UID as the document ID — no admin bottleneck
      // required to register. Must self-register as pending (isApproved
      // == false) — otherwise a client could just set isApproved: true
      // itself and skip admin review entirely; the app's own UI already
      // only ever submits false, this is the server-side backstop.
      allow create: if isAuthenticated() && driverId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isApproved == false;
      
      // Drivers can update their own availability and location
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isAvailable', 'ecoCashNumber', 'oneMoneyNumber', 'currentLatitude', 'currentLongitude', 'lastLocationUpdate', 'updatedAt']);
      
      // Admin can read/list all drivers
      allow read, list: if isAdmin();
      
      // Admin can manage all drivers
      allow create, update, delete: if isAdmin();
    }
    
    // ==================== TRANSACTIONS (Audit Trail) ====================
    
    match /transactions/{transactionId} {
      // Transactions are only readable by admin
      allow read: if isAdmin();
      
      // Transactions are created/updated by the system (Cloud Functions)
      allow create, update: if isAdmin();
      
      // No deletion of transactions (audit trail)
      allow delete: if false;
    }
    
    // ==================== ADMIN SETTINGS ====================
    
    match /admin_settings/{settingsId} {
      // Admin-only. This document holds live Paynow/EcoCash/OneMoney/
      // InnBucks credentials in plain text — "any authenticated user"
      // (i.e. any customer or driver) previously meant any signed-in
      // account could read real payment credentials straight out of
      // Firestore.
      allow read: if isAdmin();
      
      // Only admin can update settings
      allow write: if isAdmin();
    }
  }
}
